{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vernedaily",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "website"
  },
  "routes": [
    {
      "pattern": "*vernedaily.xyz/*",
      "zone_name": "vernedaily.xyz"
    }
  ]
}
